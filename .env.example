# コピー先: root/.env。Python全プロセスはrepo rootから起動する。
# WebはNEXT_PUBLIC_*とSSR用の2変数だけをapps/web/.env.localへコピーする。
# 「live必須」は将来の実接続用。現在の雛形はMockのみ対応する。

# 全Pythonプロセス | 必須 | mockなら外部呼び出し・DB更新なし。live処理は未実装。
ALTER_MODE=mock
# API | 任意（既定local） | 配置先の環境 local / preview / production。productionでは/docs・/redocを出さない
ALTER_ENVIRONMENT=local
# API/Worker/Bot/Cron | live必須 | ローカルSupabase固定値。リモート接続はTLSを設定。
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
# Web | 必須 | 開発APIのURL
NEXT_PUBLIC_API_URL=http://localhost:8000
# Web | Auth実装時必須 | pnpm db:statusのAPI URL
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Web | Auth実装時必須 | pnpm exec supabase status -o envのPUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# Web server/API | Auth実装時必須 | 同じローカルAPI URLとPublishable Key
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# API | Auth実装時必須 | ローカルAuth issuer / audience
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# API | 任意 | 許可するJWT署名方式（ES256/RS256のCSV）とJWKSのキャッシュ秒数
SUPABASE_JWT_ALGORITHMS=ES256,RS256
SUPABASE_JWKS_CACHE_SECONDS=300
# API/Bot | live必須 | Webの公開URL
WEB_URL=http://localhost:3000
# API | 必須 | 許可OriginのCSV。ワイルドカード不可。
CORS_ORIGINS=http://localhost:3000
# API/Bot | Discord実装時必須 | Discord Developer Portal > Application ID
DISCORD_CLIENT_ID=replace-with-discord-application-id
# APIのみ | Discord OAuth実装時必須 | Developer Portal > OAuth2 > Client Secret
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret
# API | Discord OAuth実装時必須 | Developer Portalに登録するWeb callback
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
# APIのみ | 私的情報の暗号化実装時必須 | 32byteの乱数を安全に生成・保管（ダミー使用禁止）
PROFILE_ENCRYPTION_KEY_V1=replace-with-base64-encoded-32-byte-key
# APIのみ | Idempotency-Key付き作成で必須 | 暗号化鍵と独立した32byte乱数のBase64。版→鍵のJSON。
# 新版をKEYSへ追加してからACTIVE_VERSIONを切替。旧版の最終作成から24時間は旧鍵を保持。
API_IDEMPOTENCY_HMAC_KEYS='{"1":"replace-with-independent-base64-encoded-32-byte-key"}'
API_IDEMPOTENCY_HMAC_ACTIVE_VERSION=1
# API認可/運営CLIのみ | 招待照合で必須 | Auth管理APIでidentityを照合（Supabase Dashboard > API Keys > Secret）。Webへ渡さない。
# ローカルは`pnpm exec supabase status -o env`のSECRET_KEY。通常CRUDには使わない。
SUPABASE_SECRET_KEY=replace-with-server-secret-only-if-needed
# Worker | #18のadapter接続時に使用する採用モデル。キーは下段ANTHROPIC_API_KEYを使う。
# モデル名だけではlive呼出を有効化しない。
LLM_MODEL=claude-sonnet-5-5
# Worker | live必須 | プラットフォーム全体の費用上限USD / lease秒
MAX_DAILY_COST_USD=1.00
JOB_LEASE_SECONDS=120
# API | 任意（既定1.00） | 利用者が設定できる1体あたり日次予算の上限USD（小数6桁まで）
AGENT_DAILY_BUDGET_MAX_USD=1.00
# API | 自律交流ON時必須 | 自律交流ONの同意文面の版（docs/23）。空ならONを409で拒否（送信先はSonnet採用済み。同意文面確定前は空のまま）
ALTER_CONSENT_VERSION=
# Bot | 必須 | falseなら直ちに正常終了。true+mockなら資格情報なしの待機プロセス。
DISCORD_ENABLED=false
# Botのみ | live必須 | Discord Developer Portal > Bot > Token
DISCORD_BOT_TOKEN=replace-with-test-bot-token
# Cron | live必須 | 1回のジョブ作成上限
SCHEDULER_BATCH_SIZE=10
# migration管理者のみ | 任意 | ローカルDB。リモート本番はCI Secret管理。
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Claude直接API | 評価CLI/#18のadapter用。Claude Consoleの購入済みクレジットを使用。Web/CIへ渡さない。
# --live指定時のみ使用。本番Worker adapterは#18で接続。
ANTHROPIC_API_KEY=
