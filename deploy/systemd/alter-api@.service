[Unit]
Description=Alter api (%i)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=alter-%i
Group=alter-%i
WorkingDirectory=/opt/alter/%i/current
EnvironmentFile=/etc/alter/%i/api.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/alter/%i/current/.venv/bin/python scripts/run_service.py api %i
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=15
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# Until application log redaction is accepted, retain only systemd lifecycle status.
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
