{
  "components": {
    "schemas": {
      "AgentSettings": {
        "properties": {
          "autonomy_enabled": {
            "title": "Autonomy Enabled",
            "type": "boolean"
          },
          "daily_budget_usd": {
            "minimum": 0.0,
            "title": "Daily Budget Usd",
            "type": "number"
          },
          "discord_publish": {
            "title": "Discord Publish",
            "type": "boolean"
          },
          "frequency_per_day": {
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Frequency Per Day",
            "type": "integer"
          },
          "max_session_usd": {
            "minimum": 0.0,
            "title": "Max Session Usd",
            "type": "number"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "web_visibility": {
            "const": "participants",
            "title": "Web Visibility",
            "type": "string"
          }
        },
        "required": [
          "autonomy_enabled",
          "frequency_per_day",
          "daily_budget_usd",
          "max_session_usd",
          "web_visibility",
          "discord_publish",
          "updated_at"
        ],
        "title": "AgentSettings",
        "type": "object"
      },
      "AgentSettingsPatch": {
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "autonomy_enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Autonomy Enabled"
          },
          "daily_budget_usd": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Daily Budget Usd"
          },
          "discord_publish": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Discord Publish"
          },
          "frequency_per_day": {
            "anyOf": [
              {
                "maximum": 2.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Frequency Per Day"
          },
          "max_session_usd": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Session Usd"
          },
          "web_visibility": {
            "anyOf": [
              {
                "const": "participants",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Web Visibility"
          }
        },
        "title": "AgentSettingsPatch",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "enum": [
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "INVITATION_REQUIRED",
              "ACCOUNT_INACTIVE",
              "NOT_FOUND",
              "METHOD_NOT_ALLOWED",
              "CONFLICT",
              "VALIDATION_ERROR",
              "RATE_LIMITED",
              "AUTHORIZATION_UNAVAILABLE",
              "SERVICE_UNAVAILABLE",
