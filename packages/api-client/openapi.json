{
  "components": {
    "schemas": {
      "ErrorBody": {
        "properties": {
          "code": {
            "enum": [
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "INVITATION_REQUIRED",
              "ACCOUNT_INACTIVE",
              "NOT_FOUND",
              "METHOD_NOT_ALLOWED",
              "CONFLICT",
              "VALIDATION_ERROR",
              "RATE_LIMITED",
              "AUTHORIZATION_UNAVAILABLE",
              "SERVICE_UNAVAILABLE",
              "INTERNAL_ERROR"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Health": {
        "properties": {
          "mode": {
            "enum": [
              "mock",
              "live"
            ],
            "title": "Mode",
            "type": "string"
          },
          "service": {
            "const": "api",
            "default": "api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "mode"
        ],
        "title": "Health",
        "type": "object"
      },
      "Profile": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "discord_dm_notifications": {
            "title": "Discord Dm Notifications",
            "type": "boolean"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "onboarded_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Onboarded At"
          },
          "web_notifications": {
            "title": "Web Notifications",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "display_name",
          "created_at",
          "web_notifications",
          "discord_dm_notifications"
        ],
        "title": "Profile",
        "type": "object"
      },
      "ProfilePatch": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "description": "\u524d\u5f8c\u306e\u7a7a\u767d\u3092\u9664\u3044\u3066 1\u301c80 \u6587\u5b57\u3002\u7a7a\u767d\u3060\u3051\u30fb\u5236\u5fa1\u6587\u5b57\u306f 422",
            "maxLength": 80,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          }
        },
        "required": [
          "display_name"
        ],
        "title": "ProfilePatch",
        "type": "object"
      }
    },
    "securitySchemes": {
      "SupabaseBearer": {
        "description": "Supabase Auth \u306e access token\uff08refresh token \u306f\u9001\u3089\u306a\u3044\uff09",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
