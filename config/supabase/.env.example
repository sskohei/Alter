# 管理者専用。Preview/Productionそれぞれ別ファイルをrepo外に作成、chmod 600。
# 実際のhost/user/certはDashboard Connectから取得。パスワードはURL encode。
# 通常アプリ: IPv4 transaction pooler。SQLAlchemy+psycopg用。
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:REPLACE@aws-REGION.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=/etc/alter/ENVIRONMENT/supabase-ca.crt
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=0
# migration/dumpのみ: IPv4 session pooler (5432)、IPv6が使える場合directも可。
# CLI用はpostgresql://。アプリ/Worker/Bot/Schedulerへ配らない。
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:REPLACE@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/etc/alter/ENVIRONMENT/supabase-ca.crt
