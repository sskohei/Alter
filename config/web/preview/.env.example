# Vercel Preview: replace origins and public key, no backend secrets.
NEXT_PUBLIC_SITE_URL=https://preview.example.invalid
API_URL=https://api-preview.example.invalid
NEXT_PUBLIC_SUPABASE_URL=https://preview-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-preview-publishable-key
ALTER_PRODUCTION_SUPABASE_URL=https://production-project.supabase.co
ALTER_REGISTERED_WEB_ORIGINS=https://preview.example.invalid
# Supabase is a public service, this policy URL must be the approved LLM policy.
ALTER_LLM_NAME=replace-with-approved-llm-provider
ALTER_LLM_DATA_POLICY_URL=https://provider.example.invalid/data-policy
