# repo外 /etc/alter/preview/<role>.env、所有者 alter-preview、600。
ALTER_MODE=live
ALTER_ENVIRONMENT=preview
ALTER_PROJECT_REF=REPLACEPREVIEW
ALTER_OTHER_PROJECT_REF=REPLACEOTHERPROJECT
DATABASE_URL=postgresql+psycopg://postgres.REPLACEPREVIEW:REPLACE@aws-REGION.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=/etc/alter/preview/supabase-ca.crt
# #28等の配備条件完了後にtrueにする。
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
ALTER_WEB_URL=https://preview-web.example.invalid
