# repo外 /etc/alter/preview/<role>.env、所有者 alter-preview、600。
ALTER_MODE=live
ALTER_ENVIRONMENT=preview
ALTER_PROJECT_REF=REPLACEPREVIEW
ALTER_OTHER_PROJECT_REF=REPLACEOTHERPROJECT
DATABASE_URL=postgresql+psycopg://postgres.REPLACEPREVIEW:REPLACE@aws-REGION.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=/etc/alter/preview/supabase-ca.crt
SUPABASE_URL=https://REPLACEPREVIEW.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE
SUPABASE_JWT_ISSUER=https://REPLACEPREVIEW.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256,RS256
WEB_URL=https://preview-web.example.invalid
CORS_ORIGINS=https://preview-web.example.invalid
SUPABASE_SECRET_KEY=REPLACE
SUPABASE_STORAGE_SECRET_KEY=REPLACE
PROFILE_ENCRYPTION_KEY_V1=REPLACE
API_IDEMPOTENCY_HMAC_KEYS='{"1":"REPLACE"}'
API_IDEMPOTENCY_HMAC_ACTIVE_VERSION=1
ALTER_CONSENT_VERSION=
LLM_ENABLED=false
MAX_DAILY_COST_USD=1.00
# Discord本人連携を設定する際にAPIだけへ追加
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://preview-web.example.invalid/auth/discord/callback
