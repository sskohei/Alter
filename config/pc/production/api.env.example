# repo外 /etc/alter/production/<role>.env、所有者 alter-production、600。
ALTER_MODE=live
ALTER_ENVIRONMENT=production
ALTER_PROJECT_REF=REPLACEPRODUCTION
ALTER_OTHER_PROJECT_REF=REPLACEOTHERPROJECT
DATABASE_URL=postgresql+psycopg://postgres.REPLACEPRODUCTION:REPLACE@aws-REGION.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=/etc/alter/production/supabase-ca.crt
SUPABASE_URL=https://REPLACEPRODUCTION.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE
SUPABASE_JWT_ISSUER=https://REPLACEPRODUCTION.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256,RS256
WEB_URL=https://production-web.example.invalid
CORS_ORIGINS=https://production-web.example.invalid
# 中継（Cloudflare Tunnel）が付ける接続元。レート制限（#32）で、loopback からの要求に限って使う
API_CLIENT_IP_HEADER=CF-Connecting-IP
SUPABASE_SECRET_KEY=REPLACE
SUPABASE_STORAGE_SECRET_KEY=REPLACE
PROFILE_ENCRYPTION_KEY_V1=REPLACE
API_IDEMPOTENCY_HMAC_KEYS='{"1":"REPLACE"}'
API_IDEMPOTENCY_HMAC_ACTIVE_VERSION=1
ALTER_CONSENT_VERSION=
LLM_ENABLED=false
MAX_DAILY_COST_USD=1.00
# Discord本人連携を設定する際にAPIだけへ追加
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://production-web.example.invalid/auth/discord/callback
